IOS_APP_VERSION = "2.2.3"
ANDROID_APP_VERSION = "2.2.3"
PROJECT_NAME = "Discourse"
IOS_APP_IDENTIFIER = "me.senin.mobile"
IOS_SHARE_EXTENSION_IDENTIFIER = "me.senin.mobile.ShareExtension"
ANDROID_PACKAGE_NAME = "me.senin.mobile"

def required_env!(name)
  value = ENV[name]
  UI.user_error!("Missing required environment variable #{name}") if value.to_s.strip.empty?
  value
end

def required_file_env!(name)
  path = required_env!(name)
  UI.user_error!("File configured by #{name} does not exist: #{path}") unless File.file?(path)
  path
end

def match_readonly?
  ENV.fetch("SENINME_MATCH_READONLY", "true").downcase != "false"
end

def match_options(type)
  {
    type: type,
    readonly: match_readonly?,
    git_url: required_env!("SENINME_MATCH_GIT_URL"),
    git_branch: ENV.fetch("SENINME_MATCH_GIT_BRANCH", "main"),
    api_key_path: required_file_env!("SENINME_ASC_API_KEY_PATH"),
    team_id: required_env!("SENINME_IOS_TEAM_ID"),
    app_identifier: [IOS_APP_IDENTIFIER, IOS_SHARE_EXTENSION_IDENTIFIER],
  }
end

def android_signing_properties
  {
    "MYAPP_VERSION" => ANDROID_APP_VERSION,
    "MYAPP_RELEASE_STORE_FILE" => required_file_env!("SENINME_ANDROID_KEYSTORE_PATH"),
    "MYAPP_RELEASE_KEY_ALIAS" => required_env!("SENINME_ANDROID_KEY_ALIAS"),
    "MYAPP_RELEASE_STORE_PASSWORD" => required_env!("SENINME_ANDROID_STORE_PASSWORD"),
    "MYAPP_RELEASE_KEY_PASSWORD" => required_env!("SENINME_ANDROID_KEY_PASSWORD"),
  }
end

default_platform :ios

platform :ios do
  desc "Fetch Senin.me App Store signing assets"
  lane :certs do
    match(**match_options("appstore"))
  end

  desc "Fetch Senin.me ad-hoc signing assets"
  lane :certs_adhoc do
    match(**match_options("adhoc"))
  end

  desc "Submit a Senin.me build to TestFlight"
  lane :release do
    team_id = required_env!("SENINME_IOS_TEAM_ID")
    api_key_path = required_file_env!("SENINME_ASC_API_KEY_PATH")

    increment_version_number_in_plist(
      xcodeproj: "./ios/#{PROJECT_NAME}.xcodeproj",
      target: PROJECT_NAME,
      version_number: IOS_APP_VERSION
    )
    increment_version_number_in_plist(
      xcodeproj: "./ios/#{PROJECT_NAME}.xcodeproj",
      target: "ShareExtension",
      version_number: IOS_APP_VERSION
    )
    increment_build_number(xcodeproj: "./ios/#{PROJECT_NAME}.xcodeproj")

    update_code_signing_settings(
      use_automatic_signing: true,
      path: "./ios/#{PROJECT_NAME}.xcodeproj",
      team_id: team_id,
      targets: [PROJECT_NAME, "ShareExtension"]
    )

    match(**match_options("appstore"))

    gym(
      scheme: PROJECT_NAME,
      export_method: "app-store",
      export_team_id: team_id,
      clean: true,
      workspace: "./ios/#{PROJECT_NAME}.xcworkspace"
    )

    pilot(
      skip_waiting_for_build_processing: true,
      api_key_path: api_key_path
    )
  end

  desc "Build and install Senin.me on a connected iOS device"
  lane :install do
    team_id = required_env!("SENINME_IOS_TEAM_ID")

    update_code_signing_settings(
      use_automatic_signing: true,
      path: "./ios/#{PROJECT_NAME}.xcodeproj",
      team_id: team_id,
      targets: [PROJECT_NAME, "ShareExtension"]
    )

    match(**match_options("adhoc"))

    gym(
      scheme: PROJECT_NAME,
      export_method: "ad-hoc",
      export_team_id: team_id,
      clean: true,
      workspace: "./ios/#{PROJECT_NAME}.xcworkspace"
    )

    install_on_device
  end
end

platform :android do
  desc "Build and install a signed Senin.me release APK"
  lane :install do
    gradle(
      task: "assemble",
      build_type: "Release",
      project_dir: "android/",
      properties: android_signing_properties
    )

    adb(command: "install -r android/app/build/outputs/apk/release/app-release.apk")
  end

  desc "Submit a signed Senin.me bundle to Google Play"
  lane :release do
    increment_version_code(gradle_file_path: "android/app/build.gradle")

    gradle(
      task: "bundle",
      build_type: "Release",
      project_dir: "android/",
      properties: android_signing_properties
    )

    upload_to_play_store(
      package_name: ANDROID_PACKAGE_NAME,
      track: ENV.fetch("SENINME_PLAY_TRACK", "internal"),
      json_key: required_file_env!("SENINME_GOOGLE_PLAY_JSON_KEY"),
      skip_upload_apk: true
    )
  end
end